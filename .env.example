# Copy this file to .env.local and fill in the values.
#
# None of these are required to run the site: with no Supabase credentials the
# public pages render from src/config/portfolio.ts, and the blog and /admin are
# simply empty.

# Supabase project credentials (Dashboard -> Project Settings -> API).
# Use the browser-safe publishable/anon key (sb_publishable_... or the legacy
# anon key). NEVER put a service_role or secret key here — RLS is the boundary,
# and a service-role key bypasses all of it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public production origin, used for canonical URLs, JSON-LD, the sitemap, RSS,
# and social-preview links. No trailing slash.
#
# Building on Vercel without this set FAILS the build rather than quietly
# publishing localhost canonical URLs. Locally it defaults to localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com

# Comma-separated Supabase Auth emails allowed into /admin. Must match the rows
# in the admin_emails table, which is what the database actually trusts.
#
# This check fails CLOSED: if the variable is unset, nobody can reach /admin —
# including you.
ADMIN_EMAILS=

# OPTIONAL — real content for the static fallback, as a single JSON object.
#
# src/config/portfolio.ts ships generic placeholders so the repository stays
# reusable. Those placeholders are also what renders if Supabase is ever
# unreachable, which is not what you want on a real deployment. Setting this
# variable deep-merges your own content over them, so your site degrades to
# your identity instead of "Your Name" — without committing it to git.
#
# Objects (hero, contact, metadata) merge field by field; arrays (projects,
# skills, socialLinks) replace wholesale. Any subset is valid. Malformed JSON
# logs a warning and falls back to the defaults rather than breaking the build.
#
# NEXT_PUBLIC_PORTFOLIO_CONFIG='{"hero":{"name":"Ada Lovelace"},"metadata":{"author":"Ada Lovelace","twitterHandle":"ada"}}'
NEXT_PUBLIC_PORTFOLIO_CONFIG=
